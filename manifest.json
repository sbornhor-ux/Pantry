/* ─── UTILITIES ────────────────────────────────────────────── */
const UTH={4:30,3:20,2:10,1:0};
const UL={4:"Critical",3:"High",2:"Medium",1:"Low"};
const UC={4:"#e74c3c",3:"#f39c12",2:"#3498db",1:"#95a5a6"};
const decay=ls=>(ls.length<2?0:ls[ls.length-2].level-ls[ls.length-1].level);
const proj=item=>Math.max(0,item.levels.at(-1).level-decay(item.levels));
const isLow=item=>item.levels.at(-1).level<=UTH[item.urgency];
const lvlClr=l=>(l<=10?"#e74c3c":l<=25?"#f39c12":l<=50?"#e67e22":"#27ae60");
const invMatch=(n,inv)=>{const lo=n.toLowerCase();return inv.find(i=>{const il=i.name.toLowerCase();return lo.includes(il)||il.includes(lo)||lo.split(/[\s,()]+/).filter(w=>w.length>3).some(w=>il.includes(w));});};
const weekStr=()=>{const d=new Date();return `${d.getMonth()+1}/${d.getDate()}/${String(d.getFullYear()).slice(-2)}`;};
const shuffle=a=>[...a].sort(()=>Math.random()-.5);

/* ─── MODAL ────────────────────────────────────────────────── */
function Modal({open,onClose,title,children}){
  if(!open)return null;
  return(<div style={S.overlay} onClick={onClose}><div style={S.modal} onClick={e=>e.stopPropagation()}>
    <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:16}}>
      <h3 style={{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:20,margin:0,color:"#1a1a2e"}}>{title}</h3>
      <button onClick={onClose} style={{background:"none",border:"none",fontSize:22,cursor:"pointer",color:"#999",padding:4}}>✕</button>
    </div>{children}
  </div></div>);
}

/* ─── ADD ITEM MODAL ───────────────────────────────────────── */
function AddItemModal({open,onClose,onAdd}){
  const[f,setF]=useState({name:"",category:"Food Staples",urgency:2,amount:"",level:100});
  const cats=["Food Staples","Fridge Sauces","Kitchen Items","Laundry Items","Cleaning Supplies","Bathroom"];
  return(<Modal open={open} onClose={onClose} title="Add Item">
    <div style={{display:"grid",gap:12}}>
      <div><label style={S.label}>Name</label><input style={S.input} value={f.name} onChange={e=>setF({...f,name:e.target.value})} placeholder="e.g. Olive Oil"/></div>
      <div><label style={S.label}>Category</label><select style={S.input} value={f.category} onChange={e=>setF({...f,category:e.target.value})}>{cats.map(c=><option key={c}>{c}</option>)}</select></div>
      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10}}>
        <div><label style={S.label}>Urgency</label><select style={S.input} value={f.urgency} onChange={e=>setF({...f,urgency:+e.target.value})}>{[1,2,3,4].map(u=><option key={u} value={u}>{u} — {UL[u]}</option>)}</select></div>
        <div><label style={S.label}>Amount</label><input style={S.input} value={f.amount} onChange={e=>setF({...f,amount:e.target.value})} placeholder="1 bottle"/></div>
      </div>
      <div><label style={S.label}>Level: {f.level}%</label><input type="range" min="0" max="100" step="5" value={f.level} onChange={e=>setF({...f,level:+e.target.value})} style={{width:"100%",accentColor:"#2d6a4f"}}/></div>
      <button onClick={()=>{if(!f.name.trim()||!f.amount.trim())return;onAdd({name:f.name.trim(),category:f.category,urgency:f.urgency,amount:f.amount.trim(),levels:[{week:weekStr(),level:f.level}]});setF({name:"",category:"Food Staples",urgency:2,amount:"",level:100});onClose();}} style={S.primaryBtn}>Add Item</button>
    </div>
  </Modal>);
}

/* ─── ADD RECIPE MODAL ─────────────────────────────────────── */
function AddRecipeModal({open,onClose,onAdd}){
  const[name,setName]=useState("");const[cat,setCat]=useState("Bowls");const[cost,setCost]=useState(3);const[time,setTime]=useState("3 hours");
  const[ingT,setIngT]=useState("");const[stT,setStT]=useState("");const[parsed,setParsed]=useState([]);const[asg,setAsg]=useState(false);
  const gc=["meat","vegetable","starch","fruit","other"];
  return(<Modal open={open} onClose={onClose} title="Add Recipe">
    <div style={{display:"grid",gap:12,maxHeight:"65vh",overflowY:"auto",paddingRight:4}}>
      <div><label style={S.label}>Name</label><input style={S.input} value={name} onChange={e=>setName(e.target.value)} placeholder="Chicken Alfredo"/></div>
      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr 1fr",gap:8}}>
        <div><label style={S.label}>Category</label><select style={S.input} value={cat} onChange={e=>setCat(e.target.value)}>{["Handhelds","Healthy","Bowls","Off Menu"].map(c=><option key={c}>{c}</option>)}</select></div>
        <div><label style={S.label}>Cost</label><select style={S.input} value={cost} onChange={e=>setCost(+e.target.value)}>{[1,2,3,4,5].map(c=><option key={c} value={c}>{c}</option>)}</select></div>
        <div><label style={S.label}>Prep</label><input style={S.input} value={time} onChange={e=>setTime(e.target.value)} placeholder="3 hours"/></div>
      </div>
      <div><label style={S.label}>Ingredients (one per line)</label><textarea style={{...S.input,minHeight:80,resize:"vertical"}} value={ingT} onChange={e=>{setIngT(e.target.value);setAsg(false);}} placeholder={"Chicken Breast (2)\nBell Peppers (3)"}/></div>
      {!asg&&ingT.trim()&&<button onClick={()=>{setParsed(ingT.split("\n").filter(l=>l.trim()).map(l=>({name:l.trim(),qty:"",groceryCat:"other"})));setAsg(true);}} style={S.secondaryBtn}>Categorize →</button>}
      {asg&&parsed.length>0&&<div style={{background:"#fafaf8",borderRadius:10,padding:12}}>
        {parsed.map((ing,i)=><div key={i} style={{display:"flex",alignItems:"center",gap:8,marginBottom:6}}>
          <span style={{flex:1,fontSize:13}}>{ing.name}</span>
          <select style={{...S.input,width:110,padding:"6px 8px"}} value={ing.groceryCat} onChange={e=>{const c=[...parsed];c[i]={...c[i],groceryCat:e.target.value};setParsed(c);}}>{gc.map(g=><option key={g} value={g}>{g[0].toUpperCase()+g.slice(1)}</option>)}</select>
        </div>)}
      </div>}
      <div><label style={S.label}>Steps (one per line)</label><textarea style={{...S.input,minHeight:80,resize:"vertical"}} value={stT} onChange={e=>setStT(e.target.value)} placeholder={"Season chicken\nSear in pan"}/></div>
      <button onClick={()=>{if(!name.trim()||parsed.length===0)return;onAdd({name:name.trim(),category:cat,cost,time,ingredients:parsed,steps:stT.split("\n").filter(l=>l.trim())});setName("");setIngT("");setStT("");setParsed([]);setAsg(false);onClose();}} style={{...S.primaryBtn,opacity:(!name.trim()||parsed.length===0)?.4:1}}>Add Recipe</button>
    </div>
  </Modal>);
}

/* ─── INVENTORY PAGE ───────────────────────────────────────── */
function InventoryPage({inventory,setInventory,filterCat,setFilterCat}){
  const[sortBy,setSortBy]=useState("urgency");const[sortDir,setSortDir]=useState("desc");const[showAdd,setShowAdd]=useState(false);
  const cats=useMemo(()=>[...new Set(inventory.map(i=>i.category))],[inventory]);
  const filtered=useMemo(()=>{
    let it=filterCat==="All"?[...inventory]:inventory.filter(i=>i.category===filterCat);
    it.sort((a,b)=>{let vA,vB;if(sortBy==="urgency"){vA=a.urgency;vB=b.urgency}else if(sortBy==="level"){vA=a.levels.at(-1).level;vB=b.levels.at(-1).level}else if(sortBy==="name"){vA=a.name.toLowerCase();vB=b.name.toLowerCase()}else{vA=a.category;vB=b.category}return sortDir==="asc"?(vA<vB?-1:vA>vB?1:0):(vA>vB?-1:vA<vB?1:0);});return it;
  },[inventory,filterCat,sortBy,sortDir]);
  const tog=c=>{if(sortBy===c)setSortDir(d=>d==="asc"?"desc":"asc");else{setSortBy(c);setSortDir("desc")}};
  const lc=inventory.filter(isLow).length;const avg=Math.round(inventory.reduce((s,i)=>s+i.levels.at(-1).level,0)/inventory.length);
  return(<div>
    <AddItemModal open={showAdd} onClose={()=>setShowAdd(false)} onAdd={item=>setInventory(p=>[...p,{...item,id:Math.max(...p.map(i=>i.id))+1}])}/>
    <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:16,gap:12}}>
      <div style={{display:"grid",gridTemplateColumns:"repeat(3,1fr)",gap:10,flex:1}}>
        <div style={S.statCard}><div style={S.statLabel}>Items</div><div style={S.statValue}>{inventory.length}</div></div>
        <div style={{...S.statCard,borderLeft:"3px solid #e74c3c"}}><div style={S.statLabel}>Low</div><div style={{...S.statValue,color:"#e74c3c"}}>{lc}</div></div>
        <div style={S.statCard}><div style={S.statLabel}>Avg</div><div style={S.statValue}>{avg}%</div></div>
      </div>
      <button onClick={()=>setShowAdd(true)} style={{...S.primaryBtn,padding:"10px 16px",fontSize:14,whiteSpace:"nowrap"}}>+ Add</button>
    </div>
    <div style={{display:"flex",gap:6,marginBottom:16,flexWrap:"wrap",overflowX:"auto",WebkitOverflowScrolling:"touch"}}>
      {["All",...cats].map(c=><button key={c} onClick={()=>setFilterCat(c)} style={{...S.chipBtn,...(filterCat===c?S.chipActive:{})}}>{c}</button>)}
    </div>
    <div style={{overflowX:"auto",WebkitOverflowScrolling:"touch"}}>
    <div style={S.tableWrap}><table style={S.table}><thead><tr>
      {[["name","Item"],["urgency","Urg"],["level","Level"]].map(([c,l])=><th key={c} style={S.th} onClick={()=>tog(c)}><span style={{cursor:"pointer",userSelect:"none"}}>{l} {sortBy===c?(sortDir==="asc"?"↑":"↓"):""}</span></th>)}
      <th style={S.th}>Amt</th>
    </tr></thead><tbody>
      {filtered.map(item=>{const cl=item.levels.at(-1).level;const low=isLow(item);return(
        <tr key={item.id} style={low?{background:"rgba(231,76,60,0.06)"}:{}}>
          <td style={S.td}><span style={{fontWeight:600,color:"#1a1a2e",fontSize:13}}>{item.name}</span>{low&&<span style={S.lowBadge}>LOW</span>}</td>
          <td style={S.td}><span style={{...S.urgBadge,background:UC[item.urgency]+"22",color:UC[item.urgency]}}>{UL[item.urgency]}</span></td>
          <td style={S.td}><div style={{display:"flex",alignItems:"center",gap:6}}><div style={S.levelBarBg}><div style={{...S.levelBarFill,width:`${cl}%`,background:lvlClr(cl)}}/></div><span style={{fontSize:12,fontWeight:600,color:lvlClr(cl),minWidth:30}}>{cl}%</span></div></td>
          <td style={{...S.td,fontSize:12,color:"#888"}}>{item.amount}</td>
        </tr>);})}
    </tbody></table></div></div>
  </div>);
}

/* ─── CHECK-IN PAGE ────────────────────────────────────────── */
function CheckInPage({inventory,setInventory}){
  const[updates,setUpdates]=useState({});const[done,setDone]=useState(false);
  const items12=useMemo(()=>[...inventory].sort((a,b)=>((5-a.urgency)*100+a.levels.at(-1).level)-((5-b.urgency)*100+b.levels.at(-1).level)).slice(0,12),[inventory]);
  if(done)return(<div style={{textAlign:"center",padding:50}}><div style={{fontSize:48,marginBottom:12}}>✓</div>
    <h2 style={{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:24,color:"#1a1a2e",marginBottom:8}}>Check-in Complete!</h2>
    <p style={{color:"#666",fontSize:14}}>Non-updated items projected via decay rate.</p>
    <button onClick={()=>{setDone(false);setUpdates({})}} style={{...S.primaryBtn,marginTop:16}}>New Check-in</button></div>);
  return(<div>
    <h2 style={{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:22,color:"#1a1a2e",marginBottom:4}}>Weekly Check-in</h2>
    <p style={{color:"#666",fontSize:13,marginBottom:16}}>Update 12 priority items. Leave blank to auto-project.</p>
    <div style={{display:"grid",gap:8}}>
      {items12.map(item=>{const cl=item.levels.at(-1).level;return(
        <div key={item.id} style={S.updateRow}>
          <div style={{flex:1,minWidth:0}}><div style={{fontWeight:600,fontSize:14,color:"#1a1a2e"}}>{item.name}</div><div style={{fontSize:11,color:"#999"}}>{item.amount}</div></div>
          <div style={{display:"flex",alignItems:"center",gap:10}}>
            <div style={{fontSize:16,fontWeight:700,color:lvlClr(cl),minWidth:36,textAlign:"right"}}>{cl}%</div>
            <span style={{color:"#ccc"}}>→</span>
            <input type="number" min="0" max="100" step="5" placeholder={`${Math.round(proj(item))}`} value={updates[item.id]??""} onChange={e=>setUpdates(p=>({...p,[item.id]:e.target.value}))}
              style={{...S.input,width:60,textAlign:"center",fontSize:15,fontWeight:700,padding:"6px"}}/>
          </div>
        </div>);})}
    </div>
    <button onClick={()=>{const ws=weekStr();setInventory(p=>p.map(item=>{if(updates[item.id]!==undefined&&updates[item.id]!=="")return{...item,levels:[...item.levels,{week:ws,level:+updates[item.id]}]};return{...item,levels:[...item.levels,{week:ws,level:Math.round(proj(item))}]};}));setDone(true);}} style={{...S.primaryBtn,marginTop:20,width:"100%"}}>Submit Check-in ✓</button>
  </div>);
}

/* ─── RECIPES PAGE ─────────────────────────────────────────── */
function RecipesPage({recipes,setRecipes,selMeals}){
  const[showAdd,setShowAdd]=useState(false);const[expanded,setExpanded]=useState(null);
  const rec=selMeals.map(i=>recipes[i]).filter(Boolean);
  const Card=({r,hl})=>(<div style={{...S.recipeCard,borderTop:hl?"3px solid #2d6a4f":"3px solid #e0dbd4"}}>
    <div style={{display:"flex",justifyContent:"space-between",alignItems:"start"}}>
      <div onClick={()=>setExpanded(expanded===r.id?null:r.id)} style={{cursor:"pointer",flex:1}}>
        {hl&&<div style={{fontSize:10,fontWeight:700,color:"#2d6a4f",textTransform:"uppercase",letterSpacing:1,marginBottom:3}}>★ This Week</div>}
        <div style={{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:18,color:"#1a1a2e"}}>{r.name}</div>
        <div style={{fontSize:12,color:"#888",marginTop:2}}>{r.category} · {"$".repeat(r.cost)} · {r.time}</div>
      </div>
      <button onClick={()=>setRecipes(p=>p.filter(x=>x.id!==r.id))} style={{background:"none",border:"none",cursor:"pointer",fontSize:16,color:"#ccc",padding:4}}>✕</button>
    </div>
    {expanded===r.id&&<div style={{marginTop:12}}>
      <div style={{fontSize:11,fontWeight:700,color:"#888",textTransform:"uppercase",marginBottom:6}}>Ingredients</div>
      <div style={{display:"flex",flexWrap:"wrap",gap:5}}>{r.ingredients.map((ing,i)=><span key={i} style={{padding:"3px 8px",background:"#f5f0eb",borderRadius:5,fontSize:12,color:"#555"}}>{ing.name}{ing.qty?` (${ing.qty})`:""}</span>)}</div>
      <div style={{fontSize:11,fontWeight:700,color:"#888",textTransform:"uppercase",marginTop:10,marginBottom:6}}>Steps</div>
      <ol style={{margin:0,paddingLeft:16,fontSize:13,color:"#555",lineHeight:1.7}}>{r.steps.map((s,i)=><li key={i}>{s}</li>)}</ol>
    </div>}
  </div>);
  return(<div>
    <AddRecipeModal open={showAdd} onClose={()=>setShowAdd(false)} onAdd={r=>setRecipes(p=>[...p,{...r,id:Math.max(...p.map(x=>x.id),0)+1}])}/>
    <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:20}}>
      <div><h2 style={{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:22,color:"#1a1a2e",margin:0}}>Cookbook</h2><p style={{color:"#888",fontSize:12,margin:"2px 0 0"}}>{recipes.length} recipes · tap to expand</p></div>
      <button onClick={()=>setShowAdd(true)} style={{...S.primaryBtn,padding:"10px 16px",fontSize:14}}>+ Add</button>
    </div>
    {rec.length>0&&<div style={{marginBottom:24}}><div style={{fontSize:12,fontWeight:700,color:"#2d6a4f",marginBottom:8,textTransform:"uppercase"}}>This Week's Picks</div><div style={{display:"grid",gap:10}}>{rec.map(r=><Card key={r.id} r={r} hl/>)}</div></div>}
    <div style={{fontSize:12,fontWeight:700,color:"#888",marginBottom:8,textTransform:"uppercase"}}>All Recipes</div>
    <div style={{display:"grid",gap:10}}>{recipes.filter((_,i)=>!selMeals.includes(i)).map(r=><Card key={r.id} r={r}/>)}</div>
  </div>);
}

/* ─── GROCERY LIST PAGE ────────────────────────────────────── */
function GroceryListPage({inventory,recipes,selMeals,setSelMeals}){
  const[ck,setCk]=useState({});
  const reroll=()=>{const sh=shuffle(recipes.map((_,i)=>i));setSelMeals([sh[0],sh[1]]);setCk({})};
  const replace=(slot)=>{const other=selMeals[slot===0?1:0];const av=recipes.map((_,i)=>i).filter(i=>i!==other);const n=av[Math.floor(Math.random()*av.length)];setSelMeals(slot===0?[n,selMeals[1]]:[selMeals[0],n]);setCk({})};
  const low=useMemo(()=>inventory.filter(isLow),[inventory]);
  const m1=recipes[selMeals[0]],m2=recipes[selMeals[1]];

  /* Build grocery list: meals first, then fill from pools */
  const groceryData=useMemo(()=>{
    if(!m1||!m2)return[];
    const allIng=[...m1.ingredients,...m2.ingredients];
    const seen=new Set();
    const buckets={meat:[],vegetable:[],starch:[],fruit:[],other:[]};
    // 1. Add meal ingredients (skip if inventory > 50%)
    allIng.forEach(ing=>{if(seen.has(ing.name))return;seen.add(ing.name);
      const m=invMatch(ing.name,inventory);if(m&&m.levels.at(-1).level>50)return;
      (buckets[ing.groceryCat]||buckets.other).push({text:`${ing.name}${ing.qty?` — ${ing.qty}`:""}`,src:"recipe"});
    });
    // 2. Fill remaining slots from pools
    const fillFrom=(pool,cat,target)=>{const current=buckets[cat]?.length||0;const need=Math.max(0,target-current);const avail=shuffle(pool.filter(p=>!seen.has(p.split("(")[0].trim())));avail.slice(0,need).forEach(p=>buckets[cat].push({text:p,src:"pool"}))};
    fillFrom(MEAT_POOL,"meat",FILL_TARGETS.meat);
    fillFrom(VEG_POOL,"vegetable",FILL_TARGETS.vegetable);
    fillFrom(STARCH_POOL,"starch",FILL_TARGETS.starch);
    fillFrom(FRUIT_POOL,"fruit",FILL_TARGETS.fruit);
    // Breakfast & Fun always from pool (no recipe ingredients here)
    const bk=shuffle(BREAKFAST_POOL).slice(0,FILL_TARGETS.breakfast).map(p=>({text:p,src:"pool"}));
    const fn=shuffle(FUN_POOL).slice(0,FILL_TARGETS.fun).map(p=>({text:p,src:"pool"}));
    return[
      {key:"meat",icon:"🥩",title:"Meat / Protein (4 lbs)",items:buckets.meat},
      {key:"veg",icon:"🥦",title:"Vegetables (4 different)",items:buckets.vegetable},
      {key:"starch",icon:"🥔",title:"Starch",items:buckets.starch},
      {key:"fruit",icon:"🍎",title:"Fruits (2)",items:buckets.fruit},
      {key:"bk",icon:"🍳",title:"Breakfast (4-5 days, 2 ppl)",items:bk},
      {key:"fun",icon:"🍫",title:"Fun / Snacks (4-5 days)",items:fn},
      {key:"other",icon:"🍽️",title:"Other Recipe Ingredients",items:buckets.other},
    ];
  },[m1,m2,inventory]);

  const toggle=k=>setCk(p=>({...p,[k]:!p[k]}));
  let total=0;groceryData.forEach(s=>total+=s.items.length);total+=low.length;
  const ckCount=Object.values(ck).filter(Boolean).length;
  if(!m1||!m2)return <div>Loading...</div>;

  return(<div>
    <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:20}}>
      <div><h2 style={{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:22,color:"#1a1a2e",margin:0}}>Grocery List</h2><p style={{color:"#888",fontSize:12,margin:"2px 0 0"}}>{ckCount}/{total} checked</p></div>
      <button onClick={reroll} style={S.secondaryBtn}>↻ New Meals</button>
    </div>
    <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10,marginBottom:24}}>
      {[{m:m1,i:0},{m:m2,i:1}].map(({m,i})=><div key={i} style={{...S.mealCard,position:"relative"}}>
        <button onClick={()=>replace(i)} style={{position:"absolute",top:8,right:10,background:"none",border:"none",cursor:"pointer",fontSize:14,color:"#ccc"}}>✕</button>
        <div style={{fontSize:10,fontWeight:700,textTransform:"uppercase",letterSpacing:1,color:"#2d6a4f",marginBottom:4}}>Meal {i+1}</div>
        <div style={{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:16,color:"#1a1a2e",marginBottom:2}}>{m.name}</div>
        <div style={{fontSize:11,color:"#888"}}>{"$".repeat(m.cost)} · {m.time}</div>
      </div>)}
    </div>
    {groceryData.map((sec,si)=>sec.items.length===0?null:<div key={si} style={{marginBottom:16}}>
      <div style={S.sectionHeader}>{sec.icon} {sec.title}</div>
      {sec.items.map((item,ii)=>{const k=`${sec.key}-${ii}`;const c=!!ck[k];return(
        <div key={k} onClick={()=>toggle(k)} style={{...S.listItem,opacity:c?.45:1,textDecoration:c?"line-through":"none",background:item.src==="recipe"?"#f0faf5":"transparent"}}>
          <div style={{...S.checkbox,background:c?"#2d6a4f":"#fff",borderColor:c?"#2d6a4f":"#ccc"}}>{c&&<span style={{color:"#fff",fontSize:11}}>✓</span>}</div>
          <span style={{flex:1,fontSize:14}}>{item.text}</span>
          {item.src==="recipe"&&<span style={{fontSize:9,color:"#2d6a4f",fontWeight:700,textTransform:"uppercase"}}>Recipe</span>}
        </div>);})}
    </div>)}
    {low.length>0&&<div style={{marginBottom:16}}>
      <div style={{...S.sectionHeader,color:"#e74c3c"}}>⚠️ Low Inventory — Restock</div>
      {low.map((item,i)=>{const k=`l-${i}`;const c=!!ck[k];const cl=item.levels.at(-1).level;return(
        <div key={k} onClick={()=>toggle(k)} style={{...S.listItem,opacity:c?.45:1,textDecoration:c?"line-through":"none",background:"#fef2f2"}}>
          <div style={{...S.checkbox,background:c?"#e74c3c":"#fff",borderColor:c?"#e74c3c":"#ccc"}}>{c&&<span style={{color:"#fff",fontSize:11}}>✓</span>}</div>
          <span style={{flex:1,fontSize:14}}>{item.name} ({item.amount})</span>
          <span style={{fontSize:12,fontWeight:700,color:"#e74c3c"}}>{cl}%</span>
        </div>);})}
    </div>}
  </div>);
}

/* ─── MAIN APP ─────────────────────────────────────────────── */
function App(){
  const[page,setPage]=useState("inventory");
  const[inventory,setInventory]=useState(()=>load("pantry_inv",DEF_INV));
  const[recipes,setRecipes]=useState(()=>load("pantry_rec",DEF_RECIPES));
  const[filterCat,setFilterCat]=useState("All");
  const[selMeals,setSelMeals]=useState(()=>load("pantry_meals",[]));

  useEffect(()=>{save("pantry_inv",inventory)},[inventory]);
  useEffect(()=>{save("pantry_rec",recipes)},[recipes]);
  useEffect(()=>{save("pantry_meals",selMeals)},[selMeals]);
  useEffect(()=>{if(recipes.length>=2&&selMeals.length===0){const sh=shuffle(recipes.map((_,i)=>i));setSelMeals([sh[0],sh[1]]);}},[recipes]);

  return(<div style={S.root}><div style={S.container}>
    <header style={S.header}>
      <div><h1 style={S.logo}>Sam & Molly's Pantry</h1><p style={S.subtitle}>Inventory · Recipes · Grocery</p></div>
    </header>
    <main style={S.main}>
      {page==="inventory"&&<InventoryPage inventory={inventory} setInventory={setInventory} filterCat={filterCat} setFilterCat={setFilterCat}/>}
      {page==="checkin"&&<CheckInPage inventory={inventory} setInventory={setInventory}/>}
      {page==="recipes"&&<RecipesPage recipes={recipes} setRecipes={setRecipes} selMeals={selMeals}/>}
      {page==="grocery"&&<GroceryListPage inventory={inventory} recipes={recipes} selMeals={selMeals} setSelMeals={setSelMeals}/>}
    </main>
    {/* Bottom Tab Bar */}
    <nav style={S.tabBar}>
      {[{key:"inventory",icon:"📦",label:"Pantry"},{key:"checkin",icon:"📋",label:"Check-in"},{key:"recipes",icon:"👨‍🍳",label:"Recipes"},{key:"grocery",icon:"🛒",label:"List"}].map(t=>
        <button key={t.key} onClick={()=>setPage(t.key)} style={{...S.tabBtn,...(page===t.key?S.tabActive:{})}}>
          <span style={{fontSize:22}}>{t.icon}</span><span style={{fontSize:10,marginTop:2}}>{t.label}</span>
        </button>
      )}
    </nav>
  </div></div>);
}

ReactDOM.createRoot(document.getElementById("root")).render(<App/>);

/* ─── STYLES ───────────────────────────────────────────────── */
const S={
  root:{minHeight:"100vh",minHeight:"100dvh",background:"linear-gradient(160deg,#f5f0eb 0%,#eae4dd 50%,#e8e2d9 100%)",fontFamily:"'DM Sans',sans-serif",color:"#333",paddingBottom:80},
  container:{maxWidth:600,margin:"0 auto",padding:"0 16px"},
  header:{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"20px 0 12px",borderBottom:"1px solid #d4c9bc"},
  logo:{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:26,color:"#1a1a2e",margin:0,letterSpacing:-.5},
  subtitle:{fontSize:12,color:"#888",margin:"2px 0 0"},
  main:{padding:"20px 0",minHeight:"60vh"},
  tabBar:{position:"fixed",bottom:0,left:0,right:0,display:"flex",background:"#fff",borderTop:"1px solid #e0dbd4",paddingBottom:"env(safe-area-inset-bottom)",zIndex:100},
  tabBtn:{flex:1,display:"flex",flexDirection:"column",alignItems:"center",justifyContent:"center",padding:"8px 0 6px",border:"none",background:"transparent",cursor:"pointer",color:"#999",fontFamily:"'DM Sans',sans-serif",fontWeight:500},
  tabActive:{color:"#2d6a4f",fontWeight:700},
  statCard:{background:"#fff",borderRadius:10,padding:"14px 12px",boxShadow:"0 1px 3px rgba(0,0,0,0.05)",borderLeft:"3px solid #2d6a4f"},
  statLabel:{fontSize:10,color:"#888",fontWeight:600,textTransform:"uppercase",letterSpacing:.6},
  statValue:{fontSize:22,fontWeight:700,color:"#1a1a2e",marginTop:2,fontFamily:"'DM Serif Display',Georgia,serif"},
  chipBtn:{padding:"5px 12px",border:"1px solid #ccc",borderRadius:16,background:"#fff",cursor:"pointer",fontSize:11,fontWeight:500,fontFamily:"'DM Sans',sans-serif",color:"#666",whiteSpace:"nowrap",flexShrink:0},
  chipActive:{background:"#2d6a4f",color:"#fff",borderColor:"#2d6a4f"},
  tableWrap:{background:"#fff",borderRadius:10,overflow:"hidden",boxShadow:"0 1px 3px rgba(0,0,0,0.05)"},
  table:{width:"100%",borderCollapse:"collapse",fontSize:13},
  th:{textAlign:"left",padding:"10px 12px",background:"#fafaf8",borderBottom:"1px solid #eee",fontWeight:600,fontSize:10,textTransform:"uppercase",letterSpacing:.5,color:"#888"},
  td:{padding:"8px 12px",borderBottom:"1px solid #f5f5f3"},
  lowBadge:{marginLeft:6,padding:"1px 5px",background:"#e74c3c18",color:"#e74c3c",fontSize:9,fontWeight:700,borderRadius:3},
  urgBadge:{padding:"2px 7px",borderRadius:5,fontSize:11,fontWeight:600},
  levelBarBg:{flex:1,height:6,background:"#eee",borderRadius:3,overflow:"hidden",maxWidth:80},
  levelBarFill:{height:"100%",borderRadius:3,transition:"width .3s"},
  updateRow:{display:"flex",alignItems:"center",gap:12,padding:"12px 14px",background:"#fff",borderRadius:10,boxShadow:"0 1px 3px rgba(0,0,0,0.04)"},
  primaryBtn:{padding:"12px 24px",background:"#2d6a4f",color:"#fff",border:"none",borderRadius:10,fontSize:15,fontWeight:600,cursor:"pointer",fontFamily:"'DM Sans',sans-serif",boxShadow:"0 2px 8px rgba(45,106,79,.25)"},
  secondaryBtn:{padding:"8px 14px",background:"#fff",color:"#2d6a4f",border:"1px solid #2d6a4f44",borderRadius:8,fontSize:12,fontWeight:600,cursor:"pointer",fontFamily:"'DM Sans',sans-serif"},
  sectionHeader:{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:16,color:"#1a1a2e",padding:"8px 0 6px",borderBottom:"1px solid #e0dbd4",marginBottom:6},
  listItem:{display:"flex",alignItems:"center",gap:10,padding:"10px 12px",borderRadius:8,cursor:"pointer",fontSize:14},
  checkbox:{width:22,height:22,borderRadius:6,border:"2px solid #ccc",display:"flex",alignItems:"center",justifyContent:"center",flexShrink:0},
  mealCard:{background:"#fff",borderRadius:10,padding:"14px 16px",boxShadow:"0 1px 3px rgba(0,0,0,0.05)",borderTop:"3px solid #2d6a4f"},
  recipeCard:{background:"#fff",borderRadius:10,padding:"14px 16px",boxShadow:"0 1px 3px rgba(0,0,0,0.05)"},
  overlay:{position:"fixed",top:0,left:0,right:0,bottom:0,background:"rgba(0,0,0,.4)",display:"flex",alignItems:"center",justifyContent:"center",zIndex:1000,padding:16},
  modal:{background:"#fff",borderRadius:14,padding:"20px 24px",maxWidth:420,width:"100%",maxHeight:"85vh",overflowY:"auto",boxShadow:"0 8px 32px rgba(0,0,0,.15)"},
  label:{display:"block",fontSize:11,fontWeight:600,color:"#888",textTransform:"uppercase",letterSpacing:.4,marginBottom:4},
  input:{width:"100%",padding:"10px 12px",border:"1px solid #ddd",borderRadius:8,fontSize:14,fontFamily:"'DM Sans',sans-serif",boxSizing:"border-box",outline:"none"},
};
</script>
<script>
if('serviceWorker' in navigator){navigator.serviceWorker.register('./sw.js').catch(()=>{});}
</script>
</body>
</html>
