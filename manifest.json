/* ══════════════════════════════════════════════════════════════
   UTILITIES
   ══════════════════════════════════════════════════════════════ */
const UTH={4:30,3:20,2:10,1:0};
const UL={4:"Critical",3:"High",2:"Medium",1:"Low"};
const UC={4:"#e74c3c",3:"#f39c12",2:"#3498db",1:"#95a5a6"};
const getDecay=ls=>(ls.length<2?0:ls[ls.length-2].level-ls[ls.length-1].level);
const getProj=item=>Math.max(0,item.levels[item.levels.length-1].level-getDecay(item.levels));
const isLow=item=>item.levels[item.levels.length-1].level<=UTH[item.urgency];
const lvlClr=l=>(l<=10?"#e74c3c":l<=25?"#f39c12":l<=50?"#e67e22":"#27ae60");
const invMatch=(n,inv)=>{const lo=n.toLowerCase();return inv.find(i=>{const il=i.name.toLowerCase();return lo.includes(il)||il.includes(lo)||lo.split(/[\s,()]+/).filter(w=>w.length>3).some(w=>il.includes(w));});};
const wkStr=()=>{const d=new Date();return d.getMonth()+1+"/"+d.getDate()+"/"+String(d.getFullYear()).slice(-2);};
const shuf=a=>[...a].sort(()=>Math.random()-.5);
const lastLvl=item=>item.levels[item.levels.length-1].level;

/* ══════════════════════════════════════════════════════════════
   MODAL
   ══════════════════════════════════════════════════════════════ */
function Modal({open,onClose,title,children}){
  if(!open)return null;
  return(<div style={S.overlay} onClick={onClose}><div style={S.modal} onClick={e=>e.stopPropagation()}>
    <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:16}}>
      <h3 style={{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:20,margin:0,color:"#1a1a2e"}}>{title}</h3>
      <button onClick={onClose} style={{background:"none",border:"none",fontSize:22,cursor:"pointer",color:"#999",padding:4}}>✕</button>
    </div>{children}
  </div></div>);
}

/* ══════════════════════════════════════════════════════════════
   ADD ITEM MODAL
   ══════════════════════════════════════════════════════════════ */
function AddItemModal({open,onClose,onAdd}){
  const[f,setF]=useState({name:"",category:"Food Staples",urgency:2,amount:"",level:100});
  const cats=["Food Staples","Fridge Sauces","Kitchen Items","Laundry Items","Cleaning Supplies","Bathroom"];
  return(<Modal open={open} onClose={onClose} title="Add Item">
    <div style={{display:"grid",gap:12}}>
      <div><label style={S.label}>Name</label><input style={S.input} value={f.name} onChange={e=>setF({...f,name:e.target.value})} placeholder="e.g. Olive Oil"/></div>
      <div><label style={S.label}>Category</label><select style={S.input} value={f.category} onChange={e=>setF({...f,category:e.target.value})}>{cats.map(c=><option key={c}>{c}</option>)}</select></div>
      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10}}>
        <div><label style={S.label}>Urgency</label><select style={S.input} value={f.urgency} onChange={e=>setF({...f,urgency:+e.target.value})}>{[1,2,3,4].map(u=><option key={u} value={u}>{u} — {UL[u]}</option>)}</select></div>
        <div><label style={S.label}>Amount</label><input style={S.input} value={f.amount} onChange={e=>setF({...f,amount:e.target.value})} placeholder="1 bottle"/></div>
      </div>
      <div><label style={S.label}>Level: {f.level}%</label><input type="range" min="0" max="100" step="5" value={f.level} onChange={e=>setF({...f,level:+e.target.value})} style={{width:"100%",accentColor:"#2d6a4f"}}/></div>
      <button onClick={()=>{if(!f.name.trim()||!f.amount.trim())return;onAdd({name:f.name.trim(),category:f.category,urgency:f.urgency,amount:f.amount.trim(),levels:[{week:wkStr(),level:f.level}]});setF({name:"",category:"Food Staples",urgency:2,amount:"",level:100});onClose();}} style={S.primaryBtn}>Add Item</button>
    </div>
  </Modal>);
}

/* ══════════════════════════════════════════════════════════════
   ADD RECIPE MODAL
   ══════════════════════════════════════════════════════════════ */
function AddRecipeModal({open,onClose,onAdd}){
  const[nm,setNm]=useState("");const[cat,setCat]=useState("Bowls");const[cost,setCost]=useState(3);const[time,setTime]=useState("3 hours");
  const[ingT,setIngT]=useState("");const[stT,setStT]=useState("");const[parsed,setParsed]=useState([]);const[asg,setAsg]=useState(false);
  const gc=["meat","vegetable","starch","fruit","other"];
  return(<Modal open={open} onClose={onClose} title="Add Recipe">
    <div style={{display:"grid",gap:12,maxHeight:"65vh",overflowY:"auto",paddingRight:4}}>
      <div><label style={S.label}>Name</label><input style={S.input} value={nm} onChange={e=>setNm(e.target.value)} placeholder="Chicken Alfredo"/></div>
      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr 1fr",gap:8}}>
        <div><label style={S.label}>Type</label><select style={S.input} value={cat} onChange={e=>setCat(e.target.value)}>{["Handhelds","Healthy","Bowls","Off Menu"].map(c=><option key={c}>{c}</option>)}</select></div>
        <div><label style={S.label}>Cost</label><select style={S.input} value={cost} onChange={e=>setCost(+e.target.value)}>{[1,2,3,4,5].map(c=><option key={c} value={c}>{c}</option>)}</select></div>
        <div><label style={S.label}>Prep</label><input style={S.input} value={time} onChange={e=>setTime(e.target.value)} placeholder="3 hours"/></div>
      </div>
      <div><label style={S.label}>Ingredients (one per line)</label><textarea style={{...S.input,minHeight:80,resize:"vertical"}} value={ingT} onChange={e=>{setIngT(e.target.value);setAsg(false);}} placeholder={"Chicken Breast (2)\nBell Peppers (3)"}/></div>
      {!asg&&ingT.trim()&&<button onClick={()=>{setParsed(ingT.split("\n").filter(l=>l.trim()).map(l=>({name:l.trim(),qty:"",groceryCat:"other"})));setAsg(true);}} style={S.secondaryBtn}>Categorize Ingredients</button>}
      {asg&&parsed.length>0&&<div style={{background:"#fafaf8",borderRadius:10,padding:12}}>
        {parsed.map((ing,i)=><div key={i} style={{display:"flex",alignItems:"center",gap:8,marginBottom:6}}>
          <span style={{flex:1,fontSize:13}}>{ing.name}</span>
          <select style={{...S.input,width:110,padding:"6px 8px"}} value={ing.groceryCat} onChange={e=>{const c=[...parsed];c[i]={...c[i],groceryCat:e.target.value};setParsed(c);}}>{gc.map(g=><option key={g} value={g}>{g[0].toUpperCase()+g.slice(1)}</option>)}</select>
        </div>)}
      </div>}
      <div><label style={S.label}>Steps (one per line)</label><textarea style={{...S.input,minHeight:80,resize:"vertical"}} value={stT} onChange={e=>setStT(e.target.value)}/></div>
      <button onClick={()=>{if(!nm.trim()||parsed.length===0)return;onAdd({name:nm.trim(),category:cat,cost,time,ingredients:parsed,steps:stT.split("\n").filter(l=>l.trim())});setNm("");setIngT("");setStT("");setParsed([]);setAsg(false);onClose();}} style={{...S.primaryBtn,opacity:(!nm.trim()||parsed.length===0)?.4:1}}>Add Recipe</button>
    </div>
  </Modal>);
}

/* ══════════════════════════════════════════════════════════════
   INVENTORY PAGE
   ══════════════════════════════════════════════════════════════ */
function InventoryPage({inventory,setInventory,filterCat,setFilterCat}){
  const[sortBy,setSortBy]=useState("urgency");const[sortDir,setSortDir]=useState("desc");const[showAdd,setShowAdd]=useState(false);
  const cats=useMemo(()=>[...new Set(inventory.map(i=>i.category))],[inventory]);
  const filtered=useMemo(()=>{
    var it=filterCat==="All"?[...inventory]:inventory.filter(i=>i.category===filterCat);
    it.sort(function(a,b){var vA,vB;if(sortBy==="urgency"){vA=a.urgency;vB=b.urgency}else if(sortBy==="level"){vA=lastLvl(a);vB=lastLvl(b)}else if(sortBy==="name"){vA=a.name.toLowerCase();vB=b.name.toLowerCase()}else{vA=a.category;vB=b.category}return sortDir==="asc"?(vA<vB?-1:vA>vB?1:0):(vA>vB?-1:vA<vB?1:0);});return it;
  },[inventory,filterCat,sortBy,sortDir]);
  var tog=function(c){if(sortBy===c)setSortDir(function(d){return d==="asc"?"desc":"asc"});else{setSortBy(c);setSortDir("desc")}};
  var lc=inventory.filter(isLow).length;var avg=Math.round(inventory.reduce(function(s,i){return s+lastLvl(i)},0)/inventory.length);
  return(<div>
    <AddItemModal open={showAdd} onClose={function(){setShowAdd(false)}} onAdd={function(item){setInventory(function(p){return[...p,Object.assign({},item,{id:Math.max.apply(null,p.map(function(i){return i.id}))+1})]})}}/>
    <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:16,gap:12}}>
      <div style={{display:"grid",gridTemplateColumns:"repeat(3,1fr)",gap:10,flex:1}}>
        <div style={S.statCard}><div style={S.statLabel}>Items</div><div style={S.statValue}>{inventory.length}</div></div>
        <div style={Object.assign({},S.statCard,{borderLeft:"3px solid #e74c3c"})}><div style={S.statLabel}>Low</div><div style={Object.assign({},S.statValue,{color:"#e74c3c"})}>{lc}</div></div>
        <div style={S.statCard}><div style={S.statLabel}>Avg</div><div style={S.statValue}>{avg}%</div></div>
      </div>
      <button onClick={function(){setShowAdd(true)}} style={Object.assign({},S.primaryBtn,{padding:"10px 16px",fontSize:14,whiteSpace:"nowrap"})}>+ Add</button>
    </div>
    <div style={{display:"flex",gap:6,marginBottom:16,flexWrap:"wrap"}}>
      {["All"].concat(cats).map(function(c){return <button key={c} onClick={function(){setFilterCat(c)}} style={Object.assign({},S.chipBtn,filterCat===c?S.chipActive:{})}>{c}</button>})}
    </div>
    <div style={S.tableWrap}><table style={S.table}><thead><tr>
      {[["name","Item"],["urgency","Urg"],["level","Level"]].map(function(pair){return <th key={pair[0]} style={S.th} onClick={function(){tog(pair[0])}}><span style={{cursor:"pointer",userSelect:"none"}}>{pair[1]} {sortBy===pair[0]?(sortDir==="asc"?"↑":"↓"):""}</span></th>})}
      <th style={S.th}>Amt</th>
    </tr></thead><tbody>
      {filtered.map(function(item){var cl=lastLvl(item);var low=isLow(item);return(
        <tr key={item.id} style={low?{background:"rgba(231,76,60,0.06)"}:{}}>
          <td style={S.td}><span style={{fontWeight:600,color:"#1a1a2e",fontSize:13}}>{item.name}</span>{low&&<span style={S.lowBadge}>LOW</span>}</td>
          <td style={S.td}><span style={Object.assign({},S.urgBadge,{background:UC[item.urgency]+"22",color:UC[item.urgency]})}>{UL[item.urgency]}</span></td>
          <td style={S.td}><div style={{display:"flex",alignItems:"center",gap:6}}><div style={S.levelBarBg}><div style={Object.assign({},S.levelBarFill,{width:cl+"%",background:lvlClr(cl)})}/></div><span style={{fontSize:12,fontWeight:600,color:lvlClr(cl),minWidth:30}}>{cl}%</span></div></td>
          <td style={Object.assign({},S.td,{fontSize:12,color:"#888"})}>{item.amount}</td>
        </tr>);})}
    </tbody></table></div>
  </div>);
}

/* ══════════════════════════════════════════════════════════════
   CHECK-IN PAGE
   ══════════════════════════════════════════════════════════════ */
function CheckInPage({inventory,setInventory}){
  const[updates,setUpdates]=useState({});const[done,setDone]=useState(false);
  const items12=useMemo(function(){return[...inventory].sort(function(a,b){return((5-a.urgency)*100+lastLvl(a))-((5-b.urgency)*100+lastLvl(b))}).slice(0,12)},[inventory]);

  if(done)return(<div style={{textAlign:"center",padding:50}}><div style={{fontSize:48,marginBottom:12}}>✓</div>
    <h2 style={{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:24,color:"#1a1a2e",marginBottom:8}}>Check-in Complete!</h2>
    <p style={{color:"#666",fontSize:14}}>Non-updated items projected via decay.</p>
    <button onClick={function(){setDone(false);setUpdates({})}} style={Object.assign({},S.primaryBtn,{marginTop:16})}>New Check-in</button></div>);

  return(<div>
    <h2 style={{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:22,color:"#1a1a2e",marginBottom:4}}>Weekly Check-in</h2>
    <p style={{color:"#666",fontSize:13,marginBottom:16}}>12 priority items. Leave blank to auto-project.</p>
    <div style={{display:"grid",gap:8}}>
      {items12.map(function(item){var cl=lastLvl(item);return(
        <div key={item.id} style={S.updateRow}>
          <div style={{flex:1,minWidth:0}}><div style={{fontWeight:600,fontSize:14,color:"#1a1a2e"}}>{item.name}</div><div style={{fontSize:11,color:"#999"}}>{item.amount}</div></div>
          <div style={{display:"flex",alignItems:"center",gap:10}}>
            <div style={{fontSize:16,fontWeight:700,color:lvlClr(cl),minWidth:36,textAlign:"right"}}>{cl}%</div>
            <span style={{color:"#ccc"}}>→</span>
            <input type="number" min="0" max="100" step="5" placeholder={""+Math.round(getProj(item))} value={updates[item.id]!=null?updates[item.id]:""} onChange={function(e){setUpdates(function(p){var n=Object.assign({},p);n[item.id]=e.target.value;return n})}}
              style={Object.assign({},S.input,{width:60,textAlign:"center",fontSize:15,fontWeight:700,padding:"6px"})}/>
          </div>
        </div>);})}
    </div>
    <button onClick={function(){var ws=wkStr();setInventory(function(p){return p.map(function(item){if(updates[item.id]!=null&&updates[item.id]!=="")return Object.assign({},item,{levels:item.levels.concat([{week:ws,level:+updates[item.id]}])});return Object.assign({},item,{levels:item.levels.concat([{week:ws,level:Math.round(getProj(item))}])})})});setDone(true)}} style={Object.assign({},S.primaryBtn,{marginTop:20,width:"100%"})}>Submit Check-in ✓</button>
  </div>);
}

/* ══════════════════════════════════════════════════════════════
   RECIPES PAGE
   ══════════════════════════════════════════════════════════════ */
function RecipesPage({recipes,setRecipes,selMeals}){
  const[showAdd,setShowAdd]=useState(false);const[exp,setExp]=useState(null);
  var rec=selMeals.map(function(i){return recipes[i]}).filter(Boolean);
  function Card(props){var r=props.r;var hl=props.hl;return(<div style={Object.assign({},S.recipeCard,{borderTop:hl?"3px solid #2d6a4f":"3px solid #e0dbd4"})}>
    <div style={{display:"flex",justifyContent:"space-between",alignItems:"start"}}>
      <div onClick={function(){setExp(exp===r.id?null:r.id)}} style={{cursor:"pointer",flex:1}}>
        {hl&&<div style={{fontSize:10,fontWeight:700,color:"#2d6a4f",textTransform:"uppercase",letterSpacing:1,marginBottom:3}}>★ This Week</div>}
        <div style={{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:18,color:"#1a1a2e"}}>{r.name}</div>
        <div style={{fontSize:12,color:"#888",marginTop:2}}>{r.category} · {"$".repeat(r.cost)} · {r.time}</div>
      </div>
      <button onClick={function(){setRecipes(function(p){return p.filter(function(x){return x.id!==r.id})})}} style={{background:"none",border:"none",cursor:"pointer",fontSize:16,color:"#ccc",padding:4}}>✕</button>
    </div>
    {exp===r.id&&<div style={{marginTop:12}}>
      <div style={{fontSize:11,fontWeight:700,color:"#888",textTransform:"uppercase",marginBottom:6}}>Ingredients</div>
      <div style={{display:"flex",flexWrap:"wrap",gap:5}}>{r.ingredients.map(function(ing,i){return <span key={i} style={{padding:"3px 8px",background:"#f5f0eb",borderRadius:5,fontSize:12,color:"#555"}}>{ing.name}{ing.qty?" ("+ing.qty+")":""}</span>})}</div>
      <div style={{fontSize:11,fontWeight:700,color:"#888",textTransform:"uppercase",marginTop:10,marginBottom:6}}>Steps</div>
      <ol style={{margin:0,paddingLeft:16,fontSize:13,color:"#555",lineHeight:1.7}}>{r.steps.map(function(s,i){return <li key={i}>{s}</li>})}</ol>
    </div>}
  </div>)}
  return(<div>
    <AddRecipeModal open={showAdd} onClose={function(){setShowAdd(false)}} onAdd={function(r){setRecipes(function(p){return p.concat([Object.assign({},r,{id:Math.max.apply(null,p.map(function(x){return x.id}).concat([0]))+1})])})}}/>
    <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:20}}>
      <div><h2 style={{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:22,color:"#1a1a2e",margin:0}}>Cookbook</h2><p style={{color:"#888",fontSize:12,margin:"2px 0 0"}}>{recipes.length} recipes · tap to expand</p></div>
      <button onClick={function(){setShowAdd(true)}} style={Object.assign({},S.primaryBtn,{padding:"10px 16px",fontSize:14})}>+ Add</button>
    </div>
    {rec.length>0&&<div style={{marginBottom:24}}><div style={{fontSize:12,fontWeight:700,color:"#2d6a4f",marginBottom:8,textTransform:"uppercase"}}>This Week</div><div style={{display:"grid",gap:10}}>{rec.map(function(r){return <Card key={r.id} r={r} hl={true}/>})}</div></div>}
    <div style={{fontSize:12,fontWeight:700,color:"#888",marginBottom:8,textTransform:"uppercase"}}>All Recipes</div>
    <div style={{display:"grid",gap:10}}>{recipes.filter(function(_,i){return selMeals.indexOf(i)===-1}).map(function(r){return <Card key={r.id} r={r} hl={false}/>})}</div>
  </div>);
}

/* ══════════════════════════════════════════════════════════════
   GROCERY LIST PAGE
   ══════════════════════════════════════════════════════════════ */
function GroceryListPage({inventory,recipes,selMeals,setSelMeals}){
  const[ck,setCk]=useState({});
  var reroll=function(){var sh=shuf(recipes.map(function(_,i){return i}));setSelMeals([sh[0],sh[1]]);setCk({})};
  var replace=function(slot){var other=selMeals[slot===0?1:0];var av=recipes.map(function(_,i){return i}).filter(function(i){return i!==other});var n=av[Math.floor(Math.random()*av.length)];setSelMeals(slot===0?[n,selMeals[1]]:[selMeals[0],n]);setCk({})};
  var low=useMemo(function(){return inventory.filter(isLow)},[inventory]);
  var m1=recipes[selMeals[0]],m2=recipes[selMeals[1]];

  var groceryData=useMemo(function(){
    if(!m1||!m2)return[];
    var allIng=m1.ingredients.concat(m2.ingredients);
    var seen={};var buckets={meat:[],vegetable:[],starch:[],fruit:[],other:[]};
    allIng.forEach(function(ing){if(seen[ing.name])return;seen[ing.name]=true;
      var m=invMatch(ing.name,inventory);if(m&&lastLvl(m)>50)return;
      var cat=ing.groceryCat||"other";if(buckets[cat])buckets[cat].push({text:ing.name+(ing.qty?" — "+ing.qty:""),src:"recipe"});
      else buckets.other.push({text:ing.name+(ing.qty?" — "+ing.qty:""),src:"recipe"});
    });
    var fillFrom=function(pool,cat,target){var current=buckets[cat]?buckets[cat].length:0;var need=Math.max(0,target-current);
      var avail=shuf(pool.filter(function(p){return!seen[p.split("(")[0].trim()]}));
      avail.slice(0,need).forEach(function(p){buckets[cat].push({text:p,src:"pool"})})};
    fillFrom(MEAT_POOL,"meat",FILL_TARGETS.meat);
    fillFrom(VEG_POOL,"vegetable",FILL_TARGETS.vegetable);
    fillFrom(STARCH_POOL,"starch",FILL_TARGETS.starch);
    fillFrom(FRUIT_POOL,"fruit",FILL_TARGETS.fruit);
    var bk=shuf(BREAKFAST_POOL).slice(0,FILL_TARGETS.breakfast).map(function(p){return{text:p,src:"pool"}});
    var fn=shuf(FUN_POOL).slice(0,FILL_TARGETS.fun).map(function(p){return{text:p,src:"pool"}});
    return[
      {key:"meat",icon:"🥩",title:"Meat / Protein",items:buckets.meat},
      {key:"veg",icon:"🥦",title:"Vegetables",items:buckets.vegetable},
      {key:"starch",icon:"🥔",title:"Starch",items:buckets.starch},
      {key:"fruit",icon:"🍎",title:"Fruits",items:buckets.fruit},
      {key:"bk",icon:"🍳",title:"Breakfast (4-5 days, 2 ppl)",items:bk},
      {key:"fun",icon:"🍫",title:"Fun / Snacks (4-5 days)",items:fn},
      {key:"other",icon:"🍽️",title:"Other Recipe Items",items:buckets.other},
    ];
  },[m1,m2,inventory]);

  var toggle=function(k){setCk(function(p){var n=Object.assign({},p);n[k]=!p[k];return n})};
  var total=0;groceryData.forEach(function(s){total+=s.items.length});total+=low.length;
  var ckCount=Object.keys(ck).filter(function(k){return ck[k]}).length;
  if(!m1||!m2)return React.createElement("div",null,"Loading...");

  function CheckItem(props){var k=props.k;var text=props.text;var bg=props.bg;var badge=props.badge;var right=props.right;var rightClr=props.rightClr;var badgeClr=props.badgeClr||"#2d6a4f";
    var c=!!ck[k];
    return(<div onClick={function(){toggle(k)}} style={Object.assign({},S.listItem,{opacity:c?.45:1,textDecoration:c?"line-through":"none",background:bg||"transparent"})}>
      <div style={Object.assign({},S.checkbox,{background:c?badgeClr:"#fff",borderColor:c?badgeClr:"#ccc"})}>{c&&<span style={{color:"#fff",fontSize:11}}>✓</span>}</div>
      <span style={{flex:1,fontSize:14}}>{text}</span>
      {badge&&<span style={{fontSize:9,color:badgeClr,fontWeight:700,textTransform:"uppercase"}}>{badge}</span>}
      {right&&<span style={{fontSize:12,fontWeight:700,color:rightClr||"#333"}}>{right}</span>}
    </div>);
  }

  return(<div>
    <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:20}}>
      <div><h2 style={{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:22,color:"#1a1a2e",margin:0}}>Grocery List</h2><p style={{color:"#888",fontSize:12,margin:"2px 0 0"}}>{ckCount}/{total} checked</p></div>
      <button onClick={reroll} style={S.secondaryBtn}>↻ New Meals</button>
    </div>
    <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10,marginBottom:24}}>
      {[{m:m1,i:0},{m:m2,i:1}].map(function(obj){return <div key={obj.i} style={Object.assign({},S.mealCard,{position:"relative"})}>
        <button onClick={function(){replace(obj.i)}} style={{position:"absolute",top:8,right:10,background:"none",border:"none",cursor:"pointer",fontSize:14,color:"#ccc"}}>✕</button>
        <div style={{fontSize:10,fontWeight:700,textTransform:"uppercase",letterSpacing:1,color:"#2d6a4f",marginBottom:4}}>Meal {obj.i+1}</div>
        <div style={{fontFamily:"'DM Serif Display',Georgia,serif",fontSize:16,color:"#1a1a2e",marginBottom:2}}>{obj.m.name}</div>
        <div style={{fontSize:11,color:"#888"}}>{"$".repeat(obj.m.cost)} · {obj.m.time}</div>
      </div>})}
    </div>
    {groceryData.map(function(sec,si){if(sec.items.length===0)return null;return <div key={si} style={{marginBottom:16}}>
      <div style={S.sectionHeader}>{sec.icon} {sec.title}</div>
      {sec.items.map(function(item,ii){return <CheckItem key={sec.key+"-"+ii} k={sec.key+"-"+ii} text={item.text} bg={item.src==="recipe"?"#f0faf5":"transparent"} badge={item.src==="recipe"?"Recipe":null}/>})}
    </div>})}
    {low.length>0&&<div style={{marginBottom:16}}>
      <div style={Object.assign({},S.sectionHeader,{color:"#e74c3c"})}>⚠️ Low Inventory — Restock</div>
      {low.map(function(item,i){return <CheckItem key={"l-"+i} k={"l-"+i} text={item.name+" ("+item.amount+")"} bg="#fef2f2" badgeClr="#e74c3c" right={lastLvl(item)+"%"} rightClr="#e74c3c"/>})}
    </div>}
  </div>);
}

/* ══════════════════════════════════════════════════════════════
   MAIN APP
   ══════════════════════════════════════════════════════════════ */
function App(){
  const[page,setPage]=useState("inventory");
  const[inventory,setInventory]=useState(function(){return loadData("pantry_inv",DEF_INV)});
  const[recipes,setRecipes]=useState(function(){return loadData("pantry_rec",DEF_REC)});
  const[filterCat,setFilterCat]=useState("All");
  const[selMeals,setSelMeals]=useState(function(){return loadData("pantry_meals",[])});

  useEffect(function(){saveData("pantry_inv",inventory)},[inventory]);
  useEffect(function(){saveData("pantry_rec",recipes)},[recipes]);
  useEffect(function(){saveData("pantry_meals",selMeals)},[selMeals]);
  useEffect(function(){if(recipes.length>=2&&selMeals.length===0){var sh=shuf(recipes.map(function(_,i){return i}));setSelMeals([sh[0],sh[1]]);}},[recipes]);

  return(<div style={S.root}><div style={S.container}>
    <header style={S.header}>
      <div><h1 style={S.logo}>Sam & Molly's Pantry</h1><p style={S.subtitle}>Inventory · Recipes · Grocery</p></div>
    </header>
    <main style={S.main}>
      {page==="inventory"&&<InventoryPage inventory={inventory} setInventory={setInventory} filterCat={filterCat} setFilterCat={setFilterCat}/>}
      {page==="checkin"&&<CheckInPage inventory={inventory} setInventory={setInventory}/>}
      {page==="recipes"&&<RecipesPage recipes={recipes} setRecipes={setRecipes} selMeals={selMeals}/>}
      {page==="grocery"&&<GroceryListPage inventory={inventory} recipes={recipes} selMeals={selMeals} setSelMeals={setSelMeals}/>}
    </main>
    <nav style={S.tabBar}>
      {[{key:"inventory",icon:"📦",label:"Pantry"},{key:"checkin",icon:"📋",label:"Check-in"},{key:"recipes",icon:"👨‍🍳",label:"Recipes"},{key:"grocery",icon:"🛒",label:"List"}].map(function(t){return(
        <button key={t.key} onClick={function(){setPage(t.key)}} style={Object.assign({},S.tabBtn,page===t.key?S.tabActive:{})}>
          <span style={{fontSize:22}}>{t.icon}</span><span style={{fontSize:10,marginTop:2}}>{t.label}</span>
        </button>
      )})}
    </nav>
  </div></div>);
}

ReactDOM.createRoot(document.getElementById("root")).render(React.createElement(App));
</script>
<script>
if('serviceWorker' in navigator){navigator.serviceWorker.register('./sw.js').catch(function(){});}
</script>
</body>
</html>
